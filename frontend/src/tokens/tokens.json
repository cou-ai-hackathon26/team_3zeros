{
  "color": {
    "mist": "#EEF2F0",
    "paper": "#FFFFFF",
    "ink": "#16302A",
    "ink-muted": "#4E6660",
    "line": "#CFD9D5",
    "forest": "#0B5D4B",
    "turmeric": "#D99A1E",
    "river": "#1F5FA8",
    "draft": "#6B5AA6",
    "signal": "#C42B1C",
    "signal-wash": "#FBE9E7"
  },
  "typography": {
    "fontFamily": "var(--font-anek-bangla), var(--font-anek-latin), 'Anek Bangla', 'Anek Latin', 'Noto Sans Bengali', 'Noto Sans', sans-serif",
    "numeralFallback": "var(--font-anek-latin), 'Anek Latin', 'Noto Sans', sans-serif",
    "scale": {
      "patientTitle": {
        "width": 112,
        "weight": 600,
        "sizeMobile": "28px",
        "sizeDesktop": "36px",
        "lineHeight": 1.25
      },
      "sectionHeading": {
        "width": 100,
        "weight": 600,
        "sizeMobile": "20px",
        "sizeDesktop": "22px",
        "lineHeight": 1.3
      },
      "bodyBangla": {
        "width": 100,
        "weight": 400,
        "size": "17px",
        "lineHeight": 1.65
      },
      "bodyEnglish": {
        "width": 100,
        "weight": 400,
        "size": "16px",
        "lineHeight": 1.5
      },
      "clinicianTable": {
        "width": 88,
        "weight": 450,
        "size": "14px",
        "lineHeight": 1.4
      },
      "numbers": {
        "width": 88,
        "weight": 500,
        "variantNumeric": "tabular-nums"
      },
      "voiceCaption": {
        "width": 106,
        "weight": 500,
        "sizeMobile": "24px",
        "sizeDesktop": "28px",
        "lineHeight": 1.45
      }
    }
  },
  "space": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "24": "24px",
    "32": "32px",
    "48": "48px",
    "72": "72px"
  },
  "radius": {
    "sm": "4px",
    "md": "12px",
    "pill": "9999px"
  },
  "elevation": {
    "float": "0 8px 24px rgba(22,48,42,.14)"
  },
  "motion": {
    "feedback": {
      "duration": "120ms",
      "easing": "cubic-bezier(.2,0,0,1)"
    },
    "state": {
      "duration": "220ms",
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "route": {
      "duration": "520ms",
      "easing": "cubic-bezier(.65,0,.35,1)"
    },
    "page": {
      "duration": "280ms",
      "easing": "cubic-bezier(.2,.8,.2,1)"
    }
  }
}
