# ============================================================================
# Medi Waypoint — Environment Configuration Template (.env.example)
# ============================================================================

# --- Backend (Django) ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-secret-key-medi-waypoint-2026
DJANGO_DEBUG=True
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# --- Option 1: ElevenLabs Voice (Recommended — only ELEVENLABS_API_KEY is needed) ---
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_AGENT_ID=

# --- Option 2: Vapi Voice Call (Only needed if you prefer Vapi instead of ElevenLabs) ---
VOICE_PROVIDER=placeholder        # set to vapi to use the real call (MASTERPLAN D-22, Q-05)
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PRIVATE_KEY=                 # backend only, never NEXT_PUBLIC
VAPI_WEBHOOK_SECRET=              # same value as the Vapi server-URL secret

# Frontend flows with no backend contract yet (default off). Each is tied to an open question in MASTERPLAN §8.2.
NEXT_PUBLIC_FEATURE_PASSWORD_RESET=false      # Q-14
NEXT_PUBLIC_FEATURE_PATIENT_PROFILE=false     # Q-15
NEXT_PUBLIC_FEATURE_ACCESS_REQUEST=false      # Q-16
NEXT_PUBLIC_FEATURE_EMAIL_VERIFICATION=false  # Q-17

# Scheduled-job policies (BACKEND 7.2). 0 = the job does nothing. Set only after the policy is decided.
REFERRAL_ESCALATION_MINUTES=0     # Q-06: minutes before an unacknowledged emergency referral escalates
REFERRAL_REMINDER_MINUTES=0       # reminder interval for unacknowledged routine referrals
TRIAGE_IDLE_TIMEOUT_MINUTES=0     # abandon triage sessions idle this long
APPOINTMENT_REQUEST_EXPIRY_HOURS=0  # Q-04: expire unanswered appointment requests

# Language model spend guard (USD per day, 0 = off) and prices per million tokens for the estimate.
LLM_DAILY_BUDGET_USD=0
LLM_PRICE_IN_PER_M=0.99
LLM_PRICE_OUT_PER_M=1.49

# Postgres with pgvector (docker compose -f docker-compose.dev.yml up -d). D-32.
DATABASE_URL=postgres://medi:medi_secret@localhost:5432/medi_waypoint

# Knowledge-base embeddings (D-33). GEMINI_API_KEY is needed even when chat runs on another provider.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TOKENS_PER_MINUTE=0     # a free Gemini key allows about 30000: set 25000 there
KNOWLEDGE_MIN_SIMILARITY=0.5      # placeholder until clinicians set it
KNOWLEDGE_MAX_UPLOAD_MB=300
